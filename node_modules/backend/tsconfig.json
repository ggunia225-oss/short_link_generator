{
    "ts-node":{
        "files": true,
        "transpileOnly": true
    },

    "compilerOptions": {
        "target": "ES2021",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "noEmit": true,
        "types": ["vite/client"]
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
}

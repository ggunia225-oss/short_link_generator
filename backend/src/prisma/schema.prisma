generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

model urls {
    id              Int         @id @default(autoincrement())
    short_code      String      @unique @db.VarChar(10)
    original_url    String      @db.Text
    clicks          Int         @default(0)
    created_at      DateTime    @default(now())
}
{
    "ts-node":{
        "files": true,
        "transpileOnly": true
    },

    "compilerOptions": {
        "target": "ES2021",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "jsx": "react-jsx",
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "types": ["node", "jest"],
        "isolatedModules": true
    },
    "include": ["src/**/*", "src/tests/**/*"],
    "exclude": ["node_modules", "dist"]
}
